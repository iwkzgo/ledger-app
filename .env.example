# 로컬에서 이 값들을 바꾸고 싶으면 이 파일을 .env로 복사해서 사용하세요.
# .env 파일은 git에 올라가지 않습니다 (.gitignore 처리됨).

# 세션 서명에 쓰이는 비밀 키. 배포 환경(Render)에서는 render.yaml이 자동 생성합니다.
SECRET_KEY=change-me-in-production

# 비워두면 로컬 SQLite(ledger.db)를 사용합니다.
# Render에 배포하면 PostgreSQL 연결 문자열이 자동으로 채워집니다.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# 쉼표로 구분된 관리자 아이디 목록. 여기 포함된 아이디로 로그인해야 /admin/users를 볼 수 있습니다.
# ADMIN_USERNAMES=your-username
